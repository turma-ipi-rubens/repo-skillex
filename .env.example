# =============================================================================
#  SkillEx — Template ÚNICO de variáveis de ambiente
# =============================================================================
#  Uso:
#    cp .env.example .env
#    node scripts/setup-env.cjs    # detecta o IP da máquina e preenche
#                                  # HOST_IP, CLIENT_URL, JITSI_DOMAIN, etc.
#    # gere segredos com:  openssl rand -hex 32
#    # cole nos campos CHANGE-ME do .env
#
#  Tanto o backend (via dotenv) quanto o Docker Compose lêem o mesmo .env
#  da raiz — não há mais .env separado dentro de backend/ nem .env.jitsi.
#
#  ⚠️  Em qualquer ambiente exposto, MUDE todos os CHANGE-ME.
#  ⚠️  O .env final NÃO vai para o git (ver .gitignore).
# =============================================================================

# ─── Host / Rede ─────────────────────────────────────────────────────────────
# HOST_IP é detectado e preenchido automaticamente por scripts/setup-env.cjs.
# Pode ser sobrescrito manualmente (ex.: HOST_IP=10.0.0.42) para forçar uma
# interface específica em máquinas com várias NICs.
HOST_IP=

# ─── Backend / API ──────────────────────────────────────────────────────────
# CLIENT_URL é derivada de HOST_IP pelo setup-env (http://<IP> em produção,
# http://<IP>:5173 quando o front roda em Vite dev — sobrescreva se precisar).
DATABASE_URL=file:./dev.db
PORT=3333
NODE_ENV=development
UPLOAD_DIR=uploads
CLIENT_URL=
JWT_SECRET=CHANGE-ME-JWT-SECRET
JWT_EXPIRES_IN=7d
MAX_UPLOAD_SIZE_MB=5

# Rate limits — afrouxe em prod sob carga, aperte para conter abuso
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# ─── Vídeo chamada Jitsi (self-hosted) ───────────────────────────────────────
# Todas as URLs/endereços abaixo são derivados de HOST_IP pelo setup-env.
# JITSI_APP_SECRET é compartilhado entre backend e prosody — mesmo valor,
# mesma variável, sem chance de divergir.
JITSI_APP_ID=skillex
JITSI_APP_SECRET=CHANGE-ME-JITSI-APP-SECRET
JITSI_DOMAIN=
JITSI_PUBLIC_URL=
JITSI_XMPP_DOMAIN=
JITSI_DOCKER_HOST_ADDRESS=
JITSI_HTTP_PORT=8000
JVB_PORT=10000
JVB_TCP_PORT=4443

# Credenciais internas Jitsi (prosody ↔ jicofo/jvb) — qualquer valor aleatório
JITSI_JICOFO_COMPONENT_SECRET=CHANGE-ME-JICOFO-COMPONENT
JITSI_JICOFO_AUTH_PASSWORD=CHANGE-ME-JICOFO-AUTH
JITSI_JVB_AUTH_PASSWORD=CHANGE-ME-JVB-AUTH

TZ=America/Sao_Paulo
